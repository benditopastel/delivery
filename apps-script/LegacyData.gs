/** Opcional: importa somente IDs/chaves ainda inexistentes. Não altera registros atuais. */
function importLegacyData(){
 setup();let count={};
 for(let [table,records] of Object.entries(LEGACY_DATA)){
  if(!DB[table])continue;
  let sh=sheet(table),headers=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0];
  let key=table==='settings'?'key':'id';
  let known=new Set(rows(table).map(r=>String(r[key]))),missing=[];
  for(let row of records){let ident=String(row[key]||'');if(!ident||known.has(ident))continue;
   known.add(ident);missing.push(headers.map(h=>cleanCell(row[h])));
  }
  if(missing.length)sh.getRange(sh.getLastRow()+1,1,missing.length,headers.length).setValues(missing);
  count[table]=missing.length;
 }
 return count;
}
